{
  "name": "uriyya-music-player",
  "productName": "uriyya-music-player",
  "version": "0.0.4",
  "description": "The Music Player for Uriyya",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "pnpm format && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome check . --write --max-diagnostics=500",
    "check:commit": "node tools/commit-checker/check-commit.js",
    "prepare": "husky install",
    "format": "biome format . --write",
    "test": "jest --coverage",
    "lint:ci": "biome ci",
    "test:ci": "jest --ci --coverage"
  },
  "keywords": [],
  "author": {
    "name": "bhbarquero-dev",
    "email": "bhbarquero@outlook.com"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "overrides": {
      "tmp": "^0.2.4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "39.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "husky": "^8.0.0"
  },
  "husky": {
    "hooks": {}
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
