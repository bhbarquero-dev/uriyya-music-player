{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uriyya Music Player",
  "version": "0.4.0",
  "identifier": "com.bhbarquero-dev.uriyya-music-player-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Uriyya Music Player",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost https://asset.localhost data: blob: filesystem: ws: wss:;",
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}