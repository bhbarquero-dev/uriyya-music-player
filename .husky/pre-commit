#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running Husky pre-commit: pnpm run check:commit"
pnpm run check:commit
STATUS=$?
if [ $STATUS -eq 0 ]; then
  echo "commit-checker: OK"
  exit 0
fi
if [ $STATUS -eq 1 ]; then
  echo "commit-checker: Advertencias detectadas; abortando commit (interactivo)."
  exit 1
fi
echo "commit-checker: Errores detectados; abortando commit."
exit 1
